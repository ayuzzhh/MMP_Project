# LandGuard Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landguard_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=landguard_db
DB_SSL=false

# Authentication & Security
JWT_SECRET=super_secret_landguard_jwt_key_2026_secure
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Razorpay Sandbox Credentials (Demo/Student Prototype)
RAZORPAY_KEY_ID=rzp_test_LandGuardKey123
RAZORPAY_KEY_SECRET=rzp_secret_LandGuardSecret456

# Storage / AWS S3
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=landguard-documents

# Geographic Scope Defaults
DEFAULT_VILLAGE=Ranpur
DEFAULT_STATE=Rajasthan
DEFAULT_DISTRICT=Kota
DEFAULT_TEHSIL=Ladpura
DEFAULT_PIN_CODE=325003
