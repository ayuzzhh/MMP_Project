# e-Stahl Environment Configuration for Vercel Deployment

# Node Environment
NODE_ENV=production

# Database (PostgreSQL + PostGIS)
# Set your cloud database URL here (e.g. from Neon.tech, Supabase, Vercel Postgres, or Railway)
# Note: If no database is provided, e-Stahl runs in resilient fallback mode with in-memory cadastre.
DATABASE_URL=postgresql://postgres:password@ep-your-db-host.neon.tech/neondb?sslmode=require
DB_SSL=true

# Security & JWT Tokens
JWT_SECRET=super_secret_e_stahl_jwt_production_key_2026
JWT_EXPIRES_IN=7d

# Razorpay Sandbox Keys (for due diligence reports & token wallet)
RAZORPAY_KEY_ID=rzp_test_eStahlKey123
RAZORPAY_KEY_SECRET=rzp_secret_eStahlSecret456
